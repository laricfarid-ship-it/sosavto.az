# Production: hosted PostgreSQL URL; never commit actual credentials.
DATABASE_URL=
APP_ORIGIN=https://sosavto-az.vercel.app
# S3-compatible storage (AWS S3 or Cloudflare R2), with a public CDN URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# AI assistant is disabled until BOTH are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local development only, never use in production.
LOCAL_DATABASE=false
