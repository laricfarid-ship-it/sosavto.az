# Production: hosted PostgreSQL URL; never commit actual credentials.
DATABASE_URL=
APP_ORIGIN=https://sosavto-az.vercel.app
# S3-compatible storage (AWS S3 or Cloudflare R2), with a public CDN URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# AI assistant is disabled until BOTH are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local development only, never use in production.
LOCAL_DATABASE=false

# Keep disabled in production until SOS acceptance testing and release approval.
SOS_ENABLED=false

# Paid vision stays OFF until the owner approves API costs and a real-image pilot.
CAR_ANALYSIS_ENABLED=false
CAR_ANALYSIS_AUDIENCE=admin
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional current provider prices, used only to estimate usage costs (not billing).
CAR_ANALYSIS_INPUT_USD_PER_MILLION=
CAR_ANALYSIS_OUTPUT_USD_PER_MILLION=
