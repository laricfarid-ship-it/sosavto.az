# Production: hosted PostgreSQL URL; never commit actual credentials.
DATABASE_URL=
APP_ORIGIN=https://sosavto-az.vercel.app
# S3-compatible storage (AWS S3 or Cloudflare R2), with a public CDN URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# AI assistant is disabled until BOTH are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local development only, never use in production.
LOCAL_DATABASE=false
# Email password recovery: verified sender required for real recipients.
RESEND_API_KEY=
EMAIL_FROM=
# Fail-closed AI spending guard. No real requests until explicitly enabled.
AI_ENABLED=false
# Must match OPENAI_MODEL after its maximum input/image/output cost is reviewed.
AI_REVIEWED_MODEL=
# Whole US cents. Reserve the full worst-case cost per call (including images/history).
# Do NOT guess these amounts; configure after model pricing and funding are reviewed.
AI_REQUEST_RESERVE_CENTS=
AI_DAILY_BUDGET_CENTS=
AI_MONTHLY_BUDGET_CENTS=
# Lifetime allowance: never automatically resets. Manual review needed to increase.
AI_TOTAL_BUDGET_CENTS=
